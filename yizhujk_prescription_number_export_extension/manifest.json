{
  "manifest_version": 3,
  "name": "处方号导出助手",
  "version": "1.0.0",
  "description": "从处方上传管理页已加载的分页接口响应中提取处方号，并导出 TXT 或 CSV。",
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://o.yizhujk.com/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://o.yizhujk.com/*"
      ],
      "js": [
        "record-utils.js",
        "page-hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://o.yizhujk.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "处方号导出助手",
    "default_popup": "popup.html"
  }
}
