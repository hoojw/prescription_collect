[Unit]
Description=Scheduled Meituan Huan prescription collection
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/opt/prescription-collector
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=HOME=/var/lib/prescription-collector
Environment=PADDLE_PDX_MODEL_SOURCE=BOS
Environment=PRESCRIPTION_OCR_THREADS=3
Environment=PADDLE_PDX_CPU_NUM_THREADS=3
Environment=OMP_NUM_THREADS=1
Environment=MKL_NUM_THREADS=1
Environment=OPENBLAS_NUM_THREADS=1
EnvironmentFile=/etc/prescription-collector/cos.env
RuntimeDirectory=prescription-collector
ExecStart=/opt/prescription-collector/run_collection_if_idle.sh -- /opt/prescription-collector/.venv/bin/python /opt/prescription-collector/collect_store_fleet.py --registry /etc/prescription-collector/stores/mt-34024037.registry.json --run-user prescription-collector
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/prescription-collector /run/prescription-collector
