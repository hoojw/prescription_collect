[Unit]
Description=On-demand headless Chrome for Meituan store %i
After=network-online.target
Wants=network-online.target
Conflicts=meituan-store-login@%i.service

[Service]
Type=simple
User=root
Group=root
EnvironmentFile=/etc/prescription-collector/browsers/%i.env
Environment=HOME=/opt/meituan-chrome-profiles/%i
ExecStart=/opt/google/chrome/chrome --headless=new --no-sandbox --disable-gpu --disable-dev-shm-usage --remote-debugging-address=127.0.0.1 --remote-debugging-port=${CHROME_PORT} --remote-allow-origins=* --user-data-dir=${CHROME_PROFILE} --noerrdialogs --no-first-run about:blank
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/meituan-chrome-profiles
