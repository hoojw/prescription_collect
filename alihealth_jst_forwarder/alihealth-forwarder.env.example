ALIHEALTH_TOP_APP_KEY=REPLACE_WITH_JUSHITA_APP_KEY
ALIHEALTH_TOP_APP_SECRET=REPLACE_WITH_JUSHITA_APP_SECRET
# These normally equal the TOP application values above. Keep explicit so the
# Qimen target application can be changed without changing code.
QIMEN_TARGET_APP_KEY=REPLACE_WITH_JUSHITA_APP_KEY
QIMEN_TARGET_APP_SECRET=REPLACE_WITH_JUSHITA_APP_SECRET
ALIHEALTH_FORWARDER_CONFIG=/etc/alihealth-forwarder/config.json
LOG_LEVEL=INFO
