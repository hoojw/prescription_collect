{
  "listen_host": "127.0.0.1",
  "listen_port": 8088,
  "api_paths": [
    "/",
    "/qimen"
  ],
  "qimen_methods": {
    "search": "replacecompany.alihealth.prescriptions.search",
    "detail": "replacecompany.alihealth.prescription.detail"
  },
